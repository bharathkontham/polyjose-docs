# Never run dependency lifecycle scripts (preinstall, install, postinstall,
# prepare) on `npm ci` or `npm install`, locally or in CI. A compromised
# dependency then can't execute code at install time.
#
# Explicit `npm run <script>` still works, but npm skips pre<script> and
# post<script> hooks under this setting, so package.json must not rely on
# them. Playwright's browser is installed by the explicit
# `npx playwright install chromium` step, not by an install script.
ignore-scripts=true
