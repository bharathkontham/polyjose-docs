---
// Starlight's footer (edit link, last updated, previous and next page), then
// the site links: the docs, Get started, GitHub, the docs source, releases and
// the changelog. Starlight renders Footer at the end of every page's content,
// the landing page included (0.42.9 Page.astro).
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
import { FOOTER } from './links';
---

<Default />
<nav class="site-footer print:hidden" aria-label="Footer">
	<ul>
		{
			FOOTER.map((link) => (
				<li>
					<a href={link.href}>
						{link.icon && <Icon name={link.icon} size="1.25em" />}
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	nav {
		margin-top: 3rem;
		border-top: 1px solid var(--sl-color-hairline);
		padding-top: 1.5rem;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		/* At least 24 px tall (WCAG 2.2, 2.5.8 Target Size (Minimum)). */
		padding-block: 0.25rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
</style>
