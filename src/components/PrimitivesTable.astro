---
// The audit register on Security › Cryptographic foundations: the status
// legend, then the credits table with one row per cryptographic primitive
// crate, from src/data/primitives.json. Each row shows the crate's exact
// version from polyjose's Cargo.lock at the commit the page names.
//
// The legend and every table row carry `data-audit-register`. The honesty
// check (scripts/check/honesty.mjs) allows the word "audited" on this page only
// inside those elements, where it reports the primitives' audit status in the
// auditors' own terms. Nothing else on the site may use it.
//
// Audit statuses:
// - "audited": a public independent report covers the crate, and the record
//   shows no gap for the release line polyjose uses.
// - "partial": a public independent review exists, but it does not cover the
//   release line polyjose uses (it reviewed an earlier one, or predates later
//   fixes or a rewrite). The note says which.
// - "none-found": no public independent audit of the crate was found.
//
// The note carries the reviewer's facts as published; the label only sorts.
// A "none-found" note already opens with its status ("No public independent
// audit found"), so that first sentence is shown as the label instead of
// repeating it.
import primitives from '../data/primitives.json';

type Status = 'audited' | 'partial' | 'none-found';

const labels: Record<Exclude<Status, 'none-found'>, string> = {
	audited: 'Audited',
	partial: 'Audited, earlier release',
};

/** The status legend shown above the table, one entry per status. */
const legend: { label: string; meaning: string }[] = [
	{ label: labels.audited, meaning: 'a public independent report covers the library.' },
	{
		label: labels.partial,
		meaning:
			'a public independent review exists, but it covered an earlier release line than the one polyjose uses, or it came before later fixes or a rewrite.',
	},
	{
		label: 'No public independent audit found',
		meaning: 'no public independent audit of the library itself was found. These libraries are widely deployed.',
	},
];

/** Splits a note into its first clause (up to the first `.` or `:`) and the rest. */
function lead(note: string): [string, string] {
	const m = /^(.*?[.:])\s+(.*)$/s.exec(note);
	return m ? [m[1], m[2]] : [note, ''];
}
---

<ul class="audit-legend" data-audit-register>
	{
		legend.map((entry) => (
			<li>
				<strong>{entry.label}</strong>: {entry.meaning}
			</li>
		))
	}
</ul>

<table class="primitives" data-primitives>
	<caption>
		The cryptographic libraries polyjose builds on, with the version polyjose locks, their upstream project,
		license, what polyjose uses each one for, and its public audit status
	</caption>
	<thead>
		<tr>
			<th scope="col">Crate</th>
			<th scope="col">Version</th>
			<th scope="col">Upstream</th>
			<th scope="col">License</th>
			<th scope="col">What polyjose uses it for</th>
			<th scope="col">Public audit status</th>
		</tr>
	</thead>
	<tbody>
		{
			primitives.map((p) => {
				const audit = p.audit as { status: Status; by?: string; year?: number; report?: string; note: string };
				return (
					<tr data-crate={p.crate} data-audit-status={audit.status} data-audit-register>
						<th scope="row">
							<a href={p.repo}>
								<code>{p.crate}</code>
							</a>
						</th>
						<td class="version">
							<code>{p.version}</code>
						</td>
						<td>{p.upstream}</td>
						<td>{p.license}</td>
						<td>{p.purpose}</td>
						<td class="audit">
							{audit.status === 'none-found' ? (
								<>
									<strong>{lead(audit.note)[0]}</strong>
									{lead(audit.note)[1] && <p>{lead(audit.note)[1]}</p>}
								</>
							) : (
								<>
									<strong>{labels[audit.status]}.</strong>{' '}
									<a href={audit.report}>
										{audit.by} report ({audit.year})
									</a>
									<p>{audit.note}</p>
								</>
							)}
						</td>
					</tr>
				);
			})
		}
	</tbody>
</table>

<style>
	.primitives {
		font-size: var(--sl-text-sm);
	}
	.primitives caption {
		caption-side: top;
		text-align: start;
		padding-block-end: 0.5rem;
		color: var(--sl-color-gray-2);
	}
	.primitives :is(th, td) {
		padding-inline: 0.5rem;
	}
	.primitives .version {
		white-space: nowrap;
	}
	.primitives .audit {
		min-width: 13rem;
	}
	.primitives td p {
		margin-block-start: 0.25rem;
	}
</style>
