---
// Renders one group of src/data/algorithms.json as a captioned table: one row
// per identifier (a row header), one column per operation, the key it takes,
// the defining RFC section with the registry's requirement level, and details.
import data from '../data/algorithms.json';

type Status = 'yes' | 'verify-only' | 'encrypt-only' | 'no';
interface Spec {
	rfc: number;
	section?: string;
}
interface Row {
	name: string;
	description: string;
	key: string;
	spec: Spec;
	level?: string;
	levelSpec?: Spec;
	status: Status;
	notSupported?: string;
	availability?: string;
	recommended?: boolean;
	deprecated?: boolean;
	note?: string;
}
interface Group {
	id: string;
	header: string;
	caption: string;
	operations: [string, string];
	rows: Row[];
}

interface Props {
	/** A group id from algorithms.json: jws-alg, jwe-alg, jwe-enc or zip. */
	group: string;
}

// Security › Not supported links go to the page for now. Its headings get
// fixed ids (the `notSupported` keys); set this to true to link to them.
const DEEP_LINK_NOT_SUPPORTED = false;

const { group: groupId } = Astro.props;
const group = (data as unknown as { groups: Group[] }).groups.find((g) => g.id === groupId);
if (!group) throw new Error(`AlgorithmMatrix: no group "${groupId}" in algorithms.json`);

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

/** Whether the first or second operation of the group works, per status. */
function supports(status: Status, index: 0 | 1): boolean {
	if (status === 'yes') return true;
	if (status === 'verify-only') return index === 1;
	if (status === 'encrypt-only') return index === 0;
	return false;
}

/** Splits `code` spans out of a data string, so they render as <code>. */
const parts = (s: string) => s.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));

const rfcLink = (spec: Spec) =>
	`https://www.rfc-editor.org/rfc/rfc${spec.rfc}${spec.section ? `#section-${spec.section}` : ''}`;
const rfcLabel = (spec: Spec) => `RFC ${spec.rfc}${spec.section ? ` §${spec.section}` : ''}`;
const notSupportedHref = (id: string) => `/security/not-supported/${DEEP_LINK_NOT_SUPPORTED ? `#${id}` : ''}`;
---

<table class="algorithm-matrix" data-group={group.id}>
	<caption>{group.caption}</caption>
	<thead>
		<tr>
			<th scope="col">Identifier</th>
			{group.operations.map((op) => <th scope="col">{capitalize(op)}</th>)}
			<th scope="col">Key</th>
			<th scope="col">Specification</th>
			<th scope="col">Details</th>
		</tr>
	</thead>
	<tbody>
		{
			group.rows.map((row) => (
				<tr>
					<th scope="row">
						<code>{row.name}</code>
					</th>
					{([0, 1] as const).map((i) =>
						supports(row.status, i) ? (
							<td>
								{row.availability
									? ['Yes, ', ...parts(row.availability).map((p) => (p.code ? <code>{p.text}</code> : p.text))]
									: 'Yes'}
							</td>
						) : (
							<td>No</td>
						),
					)}
					<td>{row.key}</td>
					<td class="spec">
						<a href={rfcLink(row.spec)}>{rfcLabel(row.spec)}</a>
						{row.level && (
							<>
								<br />
								{row.level}
								{row.levelSpec && (
									<>
										{' '}
										(<a href={rfcLink(row.levelSpec)}>{rfcLabel(row.levelSpec)}</a>)
									</>
								)}
							</>
						)}
					</td>
					<td>
						{row.description}.
						{row.recommended && <strong> Recommended for new tokens.</strong>}
						{row.deprecated && <strong> Deprecated.</strong>}
						{row.note && [' ', ...parts(row.note).map((p) => (p.code ? <code>{p.text}</code> : p.text))]}
						{row.notSupported && (
							<>
								{' '}
								<a href={notSupportedHref(row.notSupported)}>
									{row.status === 'no' ? 'Why it is not supported' : 'Why it is limited'}
								</a>
							</>
						)}
					</td>
				</tr>
			))
		}
	</tbody>
</table>

<style>
	.algorithm-matrix caption {
		caption-side: top;
		text-align: start;
		font-weight: 600;
		color: var(--sl-color-white);
		padding-block-end: 0.5rem;
	}
	.algorithm-matrix th[scope='row'],
	.algorithm-matrix .spec {
		white-space: nowrap;
	}
	.algorithm-matrix td:last-child {
		min-width: 16rem;
	}
</style>
