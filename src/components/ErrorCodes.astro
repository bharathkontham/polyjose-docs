---
// Renders src/data/error-codes.json as a captioned table: one row per stable
// error code (a row header), its one-sentence meaning and typical causes.
import data from '../data/error-codes.json';

interface ErrorCode {
	code: string;
	meaning: string;
	causes: string[];
}

const codes = (data as unknown as { codes: ErrorCode[] }).codes;

/** Splits `code` spans out of a data string, so they render as <code>. */
const parts = (s: string) => s.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
---

<table class="error-codes">
	<caption>Stable error codes, identical on every platform</caption>
	<thead>
		<tr>
			<th scope="col">Code</th>
			<th scope="col">Meaning</th>
			<th scope="col">Typical causes</th>
		</tr>
	</thead>
	<tbody>
		{
			codes.map((c) => (
				<tr id={`code-${c.code}`}>
					<th scope="row">
						<code>{c.code}</code>
					</th>
					<td>{parts(c.meaning).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</td>
					<td>
						<ul>
							{c.causes.map((cause) => (
								<li>{parts(cause).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</li>
							))}
						</ul>
					</td>
				</tr>
			))
		}
	</tbody>
</table>

<style>
	.error-codes caption {
		caption-side: top;
		text-align: start;
		font-weight: 600;
		color: var(--sl-color-white);
		padding-block-end: 0.5rem;
	}
	.error-codes th[scope='row'] {
		white-space: nowrap;
	}
	.error-codes ul {
		margin: 0;
		padding-inline-start: 1rem;
	}
</style>
